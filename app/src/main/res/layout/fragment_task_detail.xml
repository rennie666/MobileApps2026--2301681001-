<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title Header -->
            <TextView
                android:id="@+id/screen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:text="@string/title_create_task"
                android:textColor="@color/dark_accent"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Main card for input fields -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Title Input -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_title"
                        android:textColor="@color/dark_accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:alpha="0.8" />

                    <EditText
                        android:id="@+id/edit_task_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_edit_text"
                        android:hint="@string/hint_title"
                        android:textColorHint="@color/text_hint"
                        android:inputType="textCapSentences"
                        android:padding="12dp"
                        android:textColor="@color/dark_accent"
                        android:textSize="15sp" />

                    <!-- Description Input -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_description"
                        android:textColor="@color/dark_accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:alpha="0.8" />

                    <EditText
                        android:id="@+id/edit_task_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_edit_text"
                        android:hint="@string/hint_description"
                        android:textColorHint="@color/text_hint"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3"
                        android:padding="12dp"
                        android:textColor="@color/dark_accent"
                        android:textSize="15sp" />

                    <!-- Category Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_category"
                        android:textColor="@color/dark_accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:alpha="0.8" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/category_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/detail_chip_work"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_chip_selected"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:text="@string/category_work"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/detail_chip_personal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:text="@string/category_personal"
                                android:textColor="@color/dark_accent"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/detail_chip_health"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:text="@string/category_health"
                                android:textColor="@color/dark_accent"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/detail_chip_study"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip_unselected"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:text="@string/category_study"
                                android:textColor="@color/dark_accent"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Priority Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_priority"
                        android:textColor="@color/dark_accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:alpha="0.8" />

                    <LinearLayout
                        android:id="@+id/priority_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/priority_low"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="@string/priority_low"
                            android:textColor="@color/dark_accent"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/priority_medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_chip_selected"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="@string/priority_medium"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/priority_high"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="@string/priority_high"
                            android:textColor="@color/dark_accent"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Due Date Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_due_date"
                        android:textColor="@color/dark_accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:alpha="0.8" />

                    <LinearLayout
                        android:id="@+id/btn_pick_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_edit_text"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_my_calendar"
                            app:tint="@color/dark_accent" />

                        <TextView
                            android:id="@+id/tv_due_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/hint_due_date"
                            android:textColor="@color/dark_accent"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Completion Switch (shown in edit mode) -->
                    <LinearLayout
                        android:id="@+id/completion_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_completed"
                            android:textColor="@color/dark_accent"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:alpha="0.8" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_completed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/dark_accent"
                            app:trackTint="@color/switch_track" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Save, Share and Delete Buttons -->
            <Button
                android:id="@+id/btn_save_task"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/dark_accent"
                android:text="@string/btn_save"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_share_task"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_share"
                android:textColor="@color/dark_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:strokeColor="@color/dark_accent" />

            <Button
                android:id="@+id/btn_delete_task"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="40dp"
                android:text="@string/btn_delete"
                android:textColor="@color/priority_high"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:strokeColor="@color/priority_high" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
